                              "cardNumber": {
                                "type": "string"
                              },
                              "cardNumberLast4": {
                                "type": "string"
                              },
                              "productName": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string"
                              },
                              "isMainCard": {
                                "type": "boolean"
                              }
