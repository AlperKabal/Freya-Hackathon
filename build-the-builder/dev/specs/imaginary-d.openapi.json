{
 "openapi": "3.0.3",
 "info": {
  "title": "Lakeside Cooperative Bank tools (imaginary, for generalisation tests)",
  "version": "test"
 },
 "servers": [
  {
   "url": "https://example.invalid/lcb"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. One wrong answer ends the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "member_no": {
          "type": "string"
         },
         "item": {
          "type": "string",
          "enum": [
           "postcode",
           "birth_date",
           "member_since"
          ]
         },
         "given": {
          "type": "string",
          "description": "birth_date as YYYY-MM-DD, member_since as four digits"
         }
        },
        "required": [
         "member_no",
         "item",
         "given"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when nothing was done.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "correct": {
           "type": "boolean"
          },
          "tries_left": {
           "type": "integer"
          },
          "passed": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The member's facilities in arrears. Refused until all three questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "member_no": {
          "type": "string"
         }
        },
        "required": [
         "member_no"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when nothing was done.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "facilities": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "facility": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "mortgage",
               "credit_line",
               "student_loan"
              ]
             },
             "arrears": {
              "type": "number"
             },
             "late_days": {
              "type": "integer"
             },
             "monthly": {
              "type": "number"
             },
             "min_pay": {
              "type": "number"
             },
             "line_ref": {
              "type": "string"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment promise. One per facility.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "member_no": {
          "type": "string"
         },
         "facility": {
          "type": "string"
         },
         "amount_due": {
          "type": "number"
         },
         "pay_date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "member_no",
         "facility",
         "amount_due",
         "pay_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when nothing was done.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "ref": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why a facility ended without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "member_no": {
          "type": "string"
         },
         "facility": {
          "type": "string"
         },
         "code": {
          "type": "string",
          "enum": [
           "declined",
           "complaint",
           "paid",
           "hardship",
           "system_down"
          ]
         },
         "comment": {
          "type": "string"
         }
        },
        "required": [
         "member_no",
         "facility",
         "code"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when nothing was done.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "member_no": {
          "type": "string"
         },
         "on": {
          "type": "string",
          "format": "date"
         },
         "at": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "member_no",
         "on",
         "at"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when nothing was done.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "member_no": {
          "type": "string"
         },
         "desk": {
          "type": "string",
          "enum": [
           "welfare",
           "insolvency",
           "frontline"
          ]
         }
        },
        "required": [
         "member_no",
         "desk"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when nothing was done.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "member_no": {
          "type": "string"
         },
         "result": {
          "type": "string",
          "enum": [
           "booked",
           "paid",
           "handed_over",
           "unresolved",
           "identity_failed",
           "not_reached"
          ]
         },
         "why": {
          "type": "string",
          "description": "Required for every result except booked and paid."
         }
        },
        "required": [
         "member_no",
         "result"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when nothing was done.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}
