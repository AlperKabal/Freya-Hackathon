   "date": "on",
   "time": "at"
  },
  "transfer_to_agent": {
   "queue": "desk"
  },
  "close_call": {
   "outcome": "result",
   "reason": "why"
  }
 },
 "agent": {
  "self_description": "the virtual agent of Lakeside Cooperative Bank",
  "style_rules": []
 },
 "opening": {
  "first_sentence": "Hi, you are speaking with the virtual agent of Lakeside Cooperative Bank.",
  "confirm_question": "Is this {salutation} {surname}?",
  "forbidden_before_identity": [
   "arrears",
   "late",
   "owe"
  ],
  "confirmations": [
   "yes",
   "the member's name"
  ],
  "non_confirmations": [],
  "max_asks": 2,
  "answer_question_first": true,
  "unclear": {
   "outcome": "not_reached",
   "reason": "unclear"
  }
 },
 "third_party": {
  "enabled": false,
  "instructions": [
   "Do not say why you are calling."
  ],
  "callback": {
   "enabled": false,
   "include_today": false,
   "business_days_ahead": 0,
   "window_start": "09:00",
   "window_end": "17:00",
   "inclusive": true,
   "after_now": true,
   "max_asks": 0,
   "scheduled": {
    "outcome": "not_reached",
    "reason": "unclear"
   },
   "not_scheduled": {
    "outcome": "not_reached",
    "reason": "unclear"
   }
  }
 },
 "identity": {
  "questions": [
   {
    "field": "postcode",
    "ask": "What is the postcode of your home address?",
    "value_type": "text",
    "answer_format": "as said, capital letters",
    "conversion": "Remove spaces."
   },
   {
    "field": "birth_date",
    "ask": "And your date of birth?",
    "value_type": "date",
    "answer_format": "YYYY-MM-DD",
    "conversion": "Send the date as YYYY-MM-DD."
   },
   {
    "field": "member_since",
    "ask": "In which year did you join the bank?",
    "value_type": "year",
    "answer_format": "YYYY",
    "conversion": "Four digits."
   }
  ],
  "one_at_a_time": true,
  "max_wrong_total": 1,
  "wrong_may_retry": false,
  "hints": [],
  "on_failed": {
   "say": "I am sorry, I cannot go further on this call.",
   "outcome": "identity_failed",
   "reason": "wrong"
  },
  "decline": {
   "explanation": "These questions keep your account safe.",
   "max_declines": 2,
   "purpose_question_counts": false,
   "outcome": "identity_failed",
   "reason": "refused"
  },
  "result_fields": {
   "ok": "success",
   "verified": "correct",
   "all_verified": "passed",
   "wrong_left": "tries_left",
   "hint": ""
  }
 },
