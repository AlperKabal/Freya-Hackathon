   "ladder": [
    {
     "attempt": 1,
     "date": {
      "kind": "deadline"
     },
     "amount": {
      "kind": "floor"
     }
    },
    {
     "attempt": 2,
     "date": {
      "kind": "deadline"
     },
     "amount": {
      "kind": "percent_of_full",
      "percent": 60
     }
