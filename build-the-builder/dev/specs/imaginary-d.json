  "verify_identity": {
   "field": "item",
   "answer": "given"
  },
  "create_promise": {
   "product_id": "facility",
   "amount": "amount_due",
   "date": "pay_date"
  },
  "add_note": {
   "product_id": "facility",
   "reason": "code",
   "text": "comment"
  },
