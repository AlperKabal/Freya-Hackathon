  ]
 },
 "call_variables": [
  {
   "name": "member_no",
   "role": "customer_id",
   "meaning": "Pass it to every tool call."
  },
  {
   "name": "salutation",
   "role": "name",
   "meaning": "Mr, Ms, Dr ..."
  },
  {
   "name": "surname",
   "role": "name",
   "meaning": "The member's family name."
  },
  {
   "name": "call_time",
   "role": "now",
   "meaning": "The current date and time."
  }
 ],
 "addressing": "{salutation} {surname}",
