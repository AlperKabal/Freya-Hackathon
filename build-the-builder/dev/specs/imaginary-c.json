   "outcome": "outcome",
   "reason": "reason"
  }
 },
 "agent": {
  "self_description": "the automated assistant of Northwind Business Bank",
  "style_rules": []
 },
 "opening": {
  "first_sentence": "Good morning, this is the automated assistant of Northwind Business Bank. This call may be recorded.",
  "confirm_question": "May I speak with {contact_name} from {company_name}?",
  "forbidden_before_identity": [
   "arrears",
   "overdue",
   "debt"
  ],
  "confirmations": [
   "yes",
   "the contact's name"
  ],
  "non_confirmations": [],
  "max_asks": 3,
  "answer_question_first": false,
  "unclear": {
   "outcome": "no_contact",
   "reason": "unconfirmed"
  }
 },
 "third_party": {
  "enabled": true,
  "instructions": [
   "Do not say why you are calling.",
   "Ask when the contact can be reached."
  ],
  "callback": {
   "enabled": true,
   "include_today": false,
   "business_days_ahead": 2,
   "window_start": "09:00",
   "window_end": "17:30",
   "inclusive": true,
   "after_now": true,
   "max_asks": 2,
   "scheduled": {
    "outcome": "no_contact",
    "reason": "callback_booked"
   },
   "not_scheduled": {
    "outcome": "no_contact",
    "reason": "callback_refused"
   }
  }
 },
 "identity": {
  "questions": [
   {
    "field": "company_number",
    "ask": "Could you tell me the company registration number?",
    "value_type": "digits",
    "answer_format": "digits only",
    "conversion": "Remove spaces and dashes."
   },
   {
    "field": "founded_year",
    "ask": "In which year was the company founded?",
    "value_type": "year",
    "answer_format": "YYYY",
    "conversion": "Four-digit year."
   }
  ],
  "one_at_a_time": true,
  "max_wrong_total": 2,
  "wrong_may_retry": true,
  "hints": [
   {
    "value": "digits_transposed",
    "instruction": "Ask the contact to read the number again slowly.",
    "counts_as_wrong": false
   }
  ],
  "on_failed": {
   "say": "I am sorry, I cannot continue without verification.",
   "outcome": "unverified",
   "reason": "wrong_answers"
  },
  "decline": {
   "explanation": "",
   "max_declines": 1,
   "purpose_question_counts": false,
   "outcome": "unverified",
   "reason": "refused_security"
  },
  "result_fields": {
   "ok": "ok",
   "verified": "match",
   "all_verified": "complete",
   "wrong_left": "remaining_attempts",
   "hint": "hint"
  }
 },
