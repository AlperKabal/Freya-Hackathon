  },
  {
   "name": "company_name",
   "role": "address",
   "meaning": "The business that owes the money."
  },
  {
   "name": "contact_name",
   "role": "address",
   "meaning": "The person to ask for, by full name."
  },
  {
   "name": "today",
   "role": "now",
   "meaning": "The current date and time."
  }
 ],
