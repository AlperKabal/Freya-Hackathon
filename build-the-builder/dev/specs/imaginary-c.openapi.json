{
 "openapi": "3.0.3",
 "info": {
  "title": "Northwind Business Bank tools (imaginary, for schema tests)",
  "version": "test"
 },
 "servers": [
  {
   "url": "https://example.invalid/v9"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. Three wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "account_ref": {
          "type": "string"
         },
         "question": {
          "type": "string",
          "enum": [
           "company_number",
           "founded_year"
          ]
         },
         "value": {
          "type": "string",
          "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits."
         }
        },
        "required": [
         "account_ref",
         "question",
         "value"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "hint": {
           "type": "string",
           "enum": [
            "digits_transposed"
           ]
          },
          "match": {
           "type": "boolean"
          },
          "remaining_attempts": {
           "type": "integer"
          },
          "complete": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The late products. Refused until both questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "account_ref": {
          "type": "string"
         }
        },
        "required": [
         "account_ref"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "products": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "product_id": {
              "type": "string"
             },
             "type": {
              "type": "string",
              "enum": [
               "business_loan",
               "overdraft",
               "equipment_lease"
              ]
             },
             "overdue_amount": {
              "type": "number"
             },
             "days_overdue": {
              "type": "integer"
             },
             "min_due": {
              "type": "number"
             },
             "lease_rate": {
              "type": "number"
             },
             "lease_ref": {
              "type": "string"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment promise. One per product.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "product_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "account_ref": {
          "type": "string"
         },
         "sum": {
          "type": "number"
         }
        },
        "required": [
         "account_ref",
         "product_id",
         "sum",
         "date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_id": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Brief B: record why a product ended without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "product_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "declined",
           "contested",
           "settled",
           "system_error"
          ]
         },
         "text": {
          "type": "string"
         },
         "account_ref": {
          "type": "string"
         }
        },
        "required": [
         "account_ref",
         "product_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "date": {
          "type": "string",
          "format": "date"
         },
         "account_ref": {
          "type": "string"
         },
         "hour": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "account_ref",
         "date",
         "hour"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "queue": {
          "type": "string",
          "enum": [
           "specialist",
           "account_manager"
          ]
         },
         "account_ref": {
          "type": "string"
         }
        },
        "required": [
         "account_ref",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "outcome": {
          "type": "string",
          "enum": [
           "agreed",
           "settled",
           "escalated",
           "no_agreement",
           "unverified",
           "no_contact"
          ]
         },
         "reason": {
          "type": "string",
          "description": "Required for every outcome except promise and paid. See the table in the brief."
         },
         "account_ref": {
          "type": "string"
         }
        },
        "required": [
         "account_ref",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}