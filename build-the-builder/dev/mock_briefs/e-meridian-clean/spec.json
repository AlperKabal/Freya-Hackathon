 "free_rules": [
  {
   "id": "29c",
   "text": "No attempt names a date after the deadline: if its date would be later, it names the deadline.",
   "applies_to": [
    "negotiation"
   ],
   "source": "29"
  },
  {
   "id": "30",
   "text": "Persuasion attempts are counted for the whole call, at most three, and a facility never gets more than its band allows.",
   "applies_to": [
    "negotiation"
   ],
   "source": "30"
  },
  {
   "id": "31",
   "text": "A facility in the escalated band gets no persuasion attempt: a refusal ends it at once.",
   "applies_to": [
    "negotiation"
   ],
   "source": "31"
  },
  {
   "id": "50",
   "text": "A facility that was simply refused gets no note.",
   "applies_to": [
    "negotiation",
    "confirmation"
   ],
   "source": "50"
  },
  {
   "id": "4",
   "text": "A question asked before the contact is confirmed is not answered: say you can explain once you know who you are speaking with.",
   "applies_to": [
    "opening"
   ],
   "source": "4"
  }
 ],
 "rule_map": []
}
