 "agent": {
  "self_description": "the virtual assistant of Meridian Business Bank",
  "style_rules": []
 },
 "opening": {
  "first_sentence": "Hello, this is the virtual assistant of Meridian Business Bank. Calls are recorded.",
  "confirm_question": "May I speak with {contact_first_name} {contact_last_name} of {company_name}?",
  "forbidden_before_identity": [
   "overdue",
   "arrears",
   "debt",
   "payment",
   "facility",
   "loan",
   "lease",
   "overdraft",
   "card"
  ],
  "confirmations": [
   "yes",
   "speaking",
   "the contact's own name"
  ],
  "non_confirmations": [],
  "max_asks": 2,
  "answer_question_first": false,
  "unclear": {
   "outcome": "no_contact",
   "reason": "unconfirmed"
  }
 },
 "third_party": {
  "enabled": true,
  "instructions": [
   "Do not say why you are calling.",
   "Ask when the contact can be reached.",
   "Nobody but the contact may answer the verification questions, and nobody else is told anything about the facilities."
  ],
  "callback": {
   "enabled": true,
   "include_today": true,
   "business_days_ahead": 3,
   "window_start": "08:00",
   "window_end": "18:00",
   "inclusive": false,
   "after_now": true,
   "max_asks": 2,
   "scheduled": {
    "outcome": "no_contact",
    "reason": "callback_booked"
   },
   "not_scheduled": {
    "outcome": "no_contact",
    "reason": "callback_refused"
   }
  }
 },
 "identity": {
  "questions": [
   {
    "field": "company_number",
    "ask": "Could you tell me the company registration number?",
    "value_type": "digits",
    "answer_format": "eight digits",
    "conversion": "Send the eight digits, with any leading zeros and nothing else."
   },
   {
    "field": "founded_year",
    "ask": "In which year was the company founded?",
    "value_type": "year",
    "answer_format": "four digits (YYYY)",
    "conversion": "Send the year as four digits."
   }
  ],
  "one_at_a_time": true,
  "max_wrong_total": 3,
  "wrong_may_retry": true,
  "hints": [],
  "on_failed": {
   "say": "I cannot verify the company, so I have to end this call.",
   "outcome": "unverified",
   "reason": "wrong_answers"
  },
  "decline": {
   "explanation": "These checks protect the company's accounts.",
   "max_declines": 2,
   "purpose_question_counts": false,
   "outcome": "unverified",
   "reason": "declined_checks"
  },
  "result_fields": {
   "ok": "success",
   "verified": "correct",
   "all_verified": "complete",
   "wrong_left": "",
   "hint": ""
  }
 },
 "account": {
  "products_field": "facilities",
