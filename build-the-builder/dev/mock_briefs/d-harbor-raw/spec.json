{
 "spec_version": 1,
 "meta": {
  "bank_name": "Harbor Retail Bank",
  "language": "English",
  "sources": [
   "1-email.md",
   "2-policy-extract.md",
   "3-memo.md",
   "4-code-list.csv",
   "tool-api.json"
  ]
 },
 "call_variables": [
  {
   "name": "customer_ref",
   "role": "customer_id",
   "meaning": "Goes into every tool call."
  },
  {
   "name": "salutation",
   "role": "address",
   "meaning": "Mr, Ms or Mx."
  },
  {
   "name": "given_name",
   "role": "name",
   "meaning": "The customer's given name. Never used to address them."
  },
  {
   "name": "family_name",
   "role": "address",
   "meaning": "Address the customer as salutation plus family name."
  },
  {
   "name": "call_time",
   "role": "now",
   "meaning": "Date and time of the call. All date rules work from it."
  }
 ],
 "addressing": "{salutation} {family_name}",
 "tool_fields": {
  "customer_id": "customer_ref",
  "verify_identity": {
   "field": "question",
   "answer": "value"
  },
  "create_promise": {
   "product_id": "account_id",
   "amount": "promise_amount",
   "date": "pay_on"
  },
  "add_note": {
   "product_id": "account_id",
   "reason": "code",
   "text": "comment"
  },
  "schedule_callback": {
   "date": "on_date",
   "time": "at_time"
  },
  "transfer_to_agent": {
   "queue": "team"
  },
  "close_call": {
   "outcome": "result",
   "reason": "detail"
  }
 },
 "agent": {
  "self_description": "Harbor Retail Bank's automated assistant",
  "style_rules": []
 },
 "opening": {
  "first_sentence": "Hello, this is the automated assistant of Harbor Retail Bank. Please note that we record this call.",
  "confirm_question": "Am I speaking with {salutation} {family_name}?",
  "forbidden_before_identity": [
   "arrears",
   "overdue",
   "debt",
   "payment",
   "collections",
   "credit card",
   "personal loan",
   "arranged overdraft"
  ],
  "confirmations": [
   "yes",
   "speaking",
   "that is me",
   "the customer's own name"
  ],
  "non_confirmations": [
   "hello",
   "who is calling",
   "what is this about"
  ],
  "max_asks": 3,
  "answer_question_first": true,
  "unclear": {
   "outcome": "unreached",
   "reason": "not_confirmed"
  }
 },
 "third_party": {
  "enabled": true,
  "instructions": [
   "Say nothing about the reason for the call.",
   "Ask when the customer can be reached.",
   "The person may not answer the security questions for the customer and is told nothing about the accounts, even when they offer to pay."
  ],
  "callback": {
   "enabled": true,
   "include_today": false,
   "business_days_ahead": 2,
   "window_start": "09:30",
   "window_end": "16:30",
   "inclusive": true,
   "after_now": true,
   "max_asks": 3,
   "scheduled": {
    "outcome": "unreached",
    "reason": "callback_booked"
   },
   "not_scheduled": {
    "outcome": "unreached",
    "reason": "no_callback"
   }
  }
 },
 "identity": {
  "questions": [
   {
    "field": "postcode",
    "ask": "Could you tell me the postcode of your registered address?",
    "value_type": "text",
    "answer_format": "capital letters without a space",
    "conversion": "Send the postcode in capital letters without a space: 'LS6 2AB' is sent as LS62AB."
   },
   {
    "field": "birth_year",
    "ask": "And in which year were you born?",
    "value_type": "year",
    "answer_format": "four digits (YYYY)",
    "conversion": "Send the year as four digits."
   }
  ],
  "one_at_a_time": true,
  "max_wrong_total": 2,
  "wrong_may_retry": true,
  "hints": [
   {
    "value": "partial_postcode",
    "instruction": "The customer gave only a part of the postcode. Ask for the full postcode.",
    "counts_as_wrong": false
   }
  ],
  "on_failed": {
   "say": "For your security I cannot continue this call. Please ring the number on the back of your card.",
   "outcome": "unverified",
   "reason": "failed_security"
  },
  "decline": {
   "explanation": "",
   "max_declines": 1,
   "purpose_question_counts": false,
   "outcome": "unverified",
   "reason": "refused_security"
  },
  "result_fields": {
   "ok": "ok",
   "verified": "matched",
   "all_verified": "passed",
   "wrong_left": "tries_left",
   "hint": "advice"
  }
 },
 "account": {
  "products_field": "accounts",
  "product_fields": {
   "id": "account_id",
   "type": "kind",
   "past_due": "arrears",
   "days_late": "days_overdue"
  },
  "product_types": [
   {
    "type": "credit_card",
