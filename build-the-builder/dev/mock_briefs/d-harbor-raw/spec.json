 "faq": [
  {
   "trigger": "The customer asks whether they are talking to a machine.",
   "answer": "Say that you are Harbor Retail Bank's automated assistant, then carry on.",
   "source": "email 5"
  },
  {
   "trigger": "The customer asks whether this call is a scam.",
   "answer": "Say: 'You can check this call by ringing the number on the back of your card.' Then carry on.",
   "source": "email 6"
  },
  {
   "trigger": "The customer asks something the tools cannot answer.",
   "answer": "Say that you do not have that information. Never guess figures, dates or reasons.",
   "source": "email 7"
  },
  {
   "trigger": "The customer asks for a payment plan or for smaller instalments.",
   "answer": "Say: 'Payment plans can be arranged in any branch.' Then carry on with the call. The request by itself is not a refusal and nothing is transferred.",
   "source": "memo 5"
  },
  {
   "trigger": "The customer asks why the security questions are needed.",
   "answer": "Say that the questions protect the account, then ask the question again. This is not a refusal.",
   "source": "3.3"
  }
 ],
 "multi_product": {
  "enabled": true,
  "state_all_first": true,
  "ask_all_today_once": true,
  "first_ask_all": "Are you able to clear all of these today?",
  "order": "as_returned",
  "attempts_per_product": true,
  "one_date_clamped_per_product": true,
  "single_read_back": true,
  "unrecorded_on_transfer": "drop"
 },
 "notes": {
  "enabled": true,
  "for_each_product_without_promise": true,
  "reasons": [
   "declined",
   "hardship",
   "disputed",
   "already_paid",
   "system_fault"
  ],
  "on_transfer": "none"
 },
 "outcomes": {
  "table": [
   {
    "outcome": "arrangement",
    "reasons": [],
    "when": "at least one promise was recorded"
   },
   {
    "outcome": "settled",
    "reasons": [],
    "when": "the customer says the overdue amount is already paid"
   },
   {
    "outcome": "handed_over",
    "reasons": [
     "welfare",
     "complaints",
     "agent_request"
    ],
    "when": "hardship accepted, complaint, asks for a person"
   },
   {
    "outcome": "no_arrangement",
    "reasons": [
     "declined",
     "hardship",
     "disputed",
     "system_fault"
    ],
    "when": "attempts used up or call not wanted, hardship declined, dispute, promise not saved"
   },
   {
    "outcome": "unverified",
    "reasons": [
     "failed_security",
     "refused_security"
    ],
    "when": "two wrong answers, refuses security"
   },
   {
    "outcome": "unreached",
    "reasons": [
     "callback_booked",
     "no_callback",
     "wrong_number",
     "deceased",
     "not_confirmed"
    ],
    "when": "the customer was not on the line"
   }
  ],
  "reason_omitted_for": [
   "arrangement",
   "settled"
  ],
  "promise": {
   "outcome": "arrangement",
   "reason": ""
  },
  "transfer_after_promise": "promise_wins",
  "multi": {
   "all_notes_match": {
    "note_reason": "already_paid",
    "outcome": "settled",
    "reason": ""
   },
   "otherwise": {
    "outcome": "no_arrangement",
    "reason_from": "first_note_not_matching"
   }
  }
 },
 "closing": {
  "farewell": "Thank you, {salutation} {family_name}. Goodbye."
 },
 "free_rules": [
  {
   "id": "3.7b",
   "text": "An attempt never names a date after the latest promise date: if its date would be later, it names the latest promise date instead.",
   "applies_to": [
    "negotiation"
   ],
   "source": "3.7"
  },
  {
   "id": "3.7c",
   "text": "Do not repeat an offer the customer has refused.",
   "applies_to": [
    "negotiation"
   ],
   "source": "3.7"
  },
  {
   "id": "3.6b",
   "text": "An arranged overdraft has no minimum of its own: only its full overdue amount can be promised.",
   "applies_to": [
    "negotiation"
   ],
   "source": "3.6"
  },
  {
   "id": "3.6c",
   "text": "If the customer names more than the full overdue amount, the full overdue amount is recorded.",
   "applies_to": [
    "negotiation",
    "confirmation"
   ],
   "source": "3.6"
  },
  {
   "id": "3.10.6",
   "text": "On a hand-over, promises that were agreed but not yet recorded are not recorded, and no notes are added.",
   "applies_to": [
    "negotiation",
    "confirmation"
   ],
   "source": "3.10"
  }
 ],
 "rule_map": []
}
