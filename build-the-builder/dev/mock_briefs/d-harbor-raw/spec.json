   "say": "I am afraid I cannot accept less than the minimum.",
   "offer": {
    "kind": "floor"
   },
   "times": 1,
   "refused_is_flat_refusal": true
  }
 },
 "negotiation": {
  "first_ask": "Are you able to clear this amount today?",
  "proposal_never_refusal": true,
  "flat_refusal_definition": "A plain no, or no real answer.",
  "attempts_exhausted": {
   "outcome": "no_arrangement",
   "reason": "declined",
   "note_reason": "declined"
  },
  "forbidden_offers": [
   "a discount",
   "a waiver",
   "a payment holiday",
   "anything that is not in the handbook"
  ],
  "forbidden_questions": [
   "How much can you pay?"
  ]
 },
 "confirmation": {
  "read_back": [
   "product",
   "amount",
   "date"
  ],
  "question": "Shall I record that?",
  "require_clear_yes": true,
  "on_change": "revalidate_and_read_back",
  "one_promise_per_product": true,
  "after_record_change_say": "A recorded promise cannot be changed on this call. You can change it in online banking."
 },
 "recording": {
  "max_attempts": 3,
  "success_field": "ok",
  "after_success_say": "A confirmation letter will be sent to your registered address.",
