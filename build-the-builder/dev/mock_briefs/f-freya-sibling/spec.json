    {
     "attempt": 3,
     "date": {
      "kind": "deadline"
     },
     "amount": {
      "kind": "floor"
     }
    }
   ]
  }
 ],
 "dates": {
  "earliest": {
   "kind": "today"
  },
  "business_day_only": true,
  "non_business_day": "offer_next_business_day",
  "after_deadline": "offer_deadline",
  "refused_deadline_is_flat_refusal": true,
