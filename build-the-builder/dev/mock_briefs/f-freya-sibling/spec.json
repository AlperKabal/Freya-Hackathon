    "spoken_name": "personal loan",
    "floor_field": "instalment_amount"
   },
   {
    "type": "car_loan",
    "spoken_name": "car loan",
    "floor_field": "instalment_amount"
   }
  ],
  "max_products": 3,
  "statement_intro": "I am calling from the collections team about a late payment.",
  "statement_per_product": "Your {spoken_name} has a past-due amount of {past_due} and is {days_late} days late."
 },
