   "meaning": "Pass it to every tool call."
  },
  {
   "name": "first_name",
   "role": "name",
   "meaning": "The person to ask for."
  },
  {
   "name": "last_name",
   "role": "address",
   "meaning": "The person to ask for."
  },
  {
   "name": "title",
   "role": "address",
   "meaning": "Mr or Ms. Address the customer as title plus last name."
  },
  {
   "name": "now",
   "role": "now",
   "meaning": "The current date and time. All date rules use this, never the real clock."
  }
 ],
 "addressing": "{title} {last_name}",
 "tool_fields": {
  "customer_id": "customer_id",
  "verify_identity": {
   "field": "field",
   "answer": "answer"
  },
  "create_promise": {
   "product_id": "product_id",
   "amount": "amount",
   "date": "date"
  },
  "add_note": {
   "product_id": "product_id",
   "reason": "reason",
   "text": "text"
  },
  "schedule_callback": {
   "date": "date",
   "time": "time"
  },
  "transfer_to_agent": {
   "queue": "queue"
  },
  "close_call": {
   "outcome": "outcome",
   "reason": "reason"
  }
 },
 "agent": {
  "self_description": "Freya Bank's digital assistant",
  "style_rules": []
 },
 "opening": {
  "first_sentence": "Hello, this is the digital assistant of Freya Bank. Please note that we record this call.",
  "confirm_question": "Am I speaking with {title} {last_name}?",
  "forbidden_before_identity": [
   "collections",
   "debt",
   "payment",
   "credit card",
   "personal loan",
   "car loan"
  ],
  "confirmations": [
   "yes",
   "that's me",
   "speaking",
   "the customer's own name"
  ],
  "non_confirmations": [
   "hello",
   "go ahead",
   "who is this"
  ],
  "max_asks": 2,
  "answer_question_first": true,
  "unclear": {
   "outcome": "not_reached",
   "reason": "no_confirmation"
  }
 },
 "third_party": {
  "enabled": true,
  "instructions": [
   "Do not say why you are calling. Say nothing beyond the opening sentence.",
   "Ask when the customer can be reached.",
   "A relative may not answer the security questions and may not be told anything about the account, even if they offer to pay."
  ],
  "callback": {
   "enabled": true,
   "include_today": false,
   "business_days_ahead": 1,
   "window_start": "09:00",
   "window_end": "17:00",
   "inclusive": true,
   "after_now": true,
   "max_asks": 2,
   "scheduled": {
    "outcome": "not_reached",
    "reason": "callback"
   },
   "not_scheduled": {
    "outcome": "not_reached",
    "reason": "no_callback"
   }
  }
 },
 "identity": {
  "questions": [
   {
    "field": "date_of_birth",
    "ask": "Could you tell me your date of birth, please?",
    "value_type": "date",
    "answer_format": "YYYY-MM-DD",
    "conversion": "Send the date as YYYY-MM-DD, whatever way the customer said it. Read a date given only as numbers as day, then month, then year."
   },
   {
    "field": "phone_last4",
    "ask": "Could you tell me the last four digits of the phone number we have on file?",
    "value_type": "digits",
    "answer_format": "four digits",
    "conversion": "Send the four digits only."
   }
  ],
  "one_at_a_time": true,
  "max_wrong_total": 3,
  "wrong_may_retry": true,
  "hints": [
   {
    "value": "day_month_swapped",
    "instruction": "Ask the customer to say the month as a word.",
    "counts_as_wrong": false
   }
  ],
  "on_failed": {
   "say": "I am sorry, I cannot continue without verifying your identity. Please use the Freya Bank mobile app or visit a branch.",
   "outcome": "not_verified",
   "reason": "failed"
  },
  "decline": {
   "explanation": "These questions protect your account.",
   "max_declines": 2,
   "purpose_question_counts": true,
   "outcome": "not_verified",
   "reason": "declined"
  },
  "result_fields": {
   "ok": "ok",
   "verified": "verified",
   "all_verified": "all_verified",
   "wrong_left": "wrong_answers_left",
   "hint": "hint"
  }
 },
 "account": {
  "products_field": "products",
  "product_fields": {
   "id": "product_id",
   "type": "type",
   "past_due": "past_due",
   "days_late": "days_late"
  },
  "product_types": [
   {
    "type": "credit_card",
    "spoken_name": "credit card ending {card_last4}",
    "floor_field": "minimum_payment"
   },
   {
