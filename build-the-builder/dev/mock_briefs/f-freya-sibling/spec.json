   "next": "upcoming",
   "this": "upcoming"
  }
 },
 "amounts": {
  "first_offer": {
   "kind": "full"
  },
  "never_ask_open_amount": true,
  "accept_min": {
   "kind": "floor"
  },
  "accept_max": {
   "kind": "full"
  },
  "too_much": {
   "offer": {
    "kind": "floor"
   },
   "times": 1,
   "say": "The rest stays overdue.",
   "refused_is_flat_refusal": true
  },
  "below_min": {
   "say": "I am not able to accept that amount.",
   "offer": {
    "kind": "floor"
   },
   "times": 1,
   "refused_is_flat_refusal": true
  }
 },
 "negotiation": {
  "first_ask": "Could you pay this amount today?",
  "proposal_never_refusal": true,
  "flat_refusal_definition": "A flat refusal or a non-answer. A no to paying today with no date and no amount is a flat refusal.",
  "attempts_exhausted": {
   "outcome": "no_promise",
   "reason": "refused",
   "note_reason": "refused"
  },
  "forbidden_offers": [
   "a discount",
   "a waiver",
   "an instalment plan",
   "any term that is not in this brief"
  ],
  "forbidden_questions": [
   "How much can you pay?"
  ]
 },
 "confirmation": {
  "read_back": [
   "product",
   "amount",
   "date"
  ],
  "question": "Is that right?",
  "require_clear_yes": true,
  "on_change": "revalidate_and_read_back",
  "one_promise_per_product": true,
  "after_record_change_say": "A recorded promise cannot be changed or cancelled in this call. You can change it in the mobile app."
 },
 "recording": {
  "max_attempts": 3,
  "success_field": "ok",
  "after_success_say": "We will send you an e-mail to confirm this promise.",
  "retry_say": "Sorry, there was a technical problem. Let me try once more.",
  "failure_say": "I am sorry, I could not record the promise because of a technical problem.",
  "on_final_failure": {
   "outcome": "no_promise",
   "reason": "service_error",
   "note_reason": "service_error"
  }
 },
