 "faq": [
  {
   "trigger": "The customer asks whether they are talking to a robot or an AI.",
   "answer": "Say that you are Freya Bank's digital assistant, then continue.",
   "source": "A4"
  },
  {
   "trigger": "The customer asks whether this call is a scam.",
   "answer": "Say they can verify the call by phoning Freya Bank's customer service number, then continue.",
   "source": "A43"
  },
  {
   "trigger": "The customer asks something the tools cannot answer.",
   "answer": "Say you do not have that information. Do not invent figures, dates or reasons.",
   "source": "A44"
  }
 ],
 "multi_product": {
  "enabled": true,
  "state_all_first": true,
  "ask_all_today_once": true,
  "first_ask_all": "Can you pay all of them today?",
  "order": "as_returned",
  "attempts_per_product": true,
  "one_date_clamped_per_product": true,
  "single_read_back": true,
  "unrecorded_on_transfer": "drop"
 },
 "notes": {
  "enabled": true,
  "for_each_product_without_promise": true,
  "reasons": [
   "refused",
   "hardship",
   "dispute",
   "paid",
   "service_error"
  ],
  "on_transfer": "none"
 },
 "outcomes": {
  "table": [
   {
    "outcome": "promise",
    "reasons": [],
    "when": "at least one promise was recorded"
   },
   {
    "outcome": "paid",
    "reasons": [],
    "when": "the customer already paid (A39)"
   },
   {
    "outcome": "transferred",
    "reasons": [
     "restructuring",
     "human",
     "support"
    ],
    "when": "A41, A42, A32"
   },
   {
    "outcome": "no_promise",
    "reasons": [
     "refused",
     "hardship",
     "dispute",
     "service_error"
    ],
    "when": "A31 and A45, A32, A40, A37"
   },
   {
    "outcome": "not_verified",
    "reasons": [
     "failed",
     "declined"
    ],
    "when": "A14, A15"
   },
   {
    "outcome": "not_reached",
    "reasons": [
     "callback",
     "no_callback",
     "wrong_number",
     "deceased",
     "no_confirmation"
    ],
    "when": "A6, A7, A8, A9, A3"
   }
  ],
