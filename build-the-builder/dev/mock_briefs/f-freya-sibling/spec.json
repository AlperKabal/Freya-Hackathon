    "note_reason": "paid",
    "outcome": "paid",
    "reason": ""
   },
   "otherwise": {
    "outcome": "no_promise",
    "reason_from": "first_note_not_matching"
   }
  }
 },
 "closing": {
  "farewell": "Thank you for your time. Goodbye."
 },
 "free_rules": [
  {
   "id": "A3b",
   "text": "Answer a question from the customer first. The ask that follows is the second ask.",
   "applies_to": [
    "opening"
   ],
   "source": "A3"
  },
  {
   "id": "A31b",
   "text": "Do not repeat an offer the customer already refused.",
   "applies_to": [
    "negotiation"
   ],
   "source": "A31"
  },
  {
   "id": "A24b",
   "text": "The agent proposes every amount.",
   "applies_to": [
    "negotiation"
   ],
   "source": "A24"
  },
  {
   "id": "A15b",
   "text": "Asking what the call is about instead of answering counts as declining.",
   "applies_to": [
    "identity"
   ],
   "source": "A15"
  },
  {
   "id": "B3",
   "text": "The band and the deadline are per product, from that product's days late. Two products of the same customer can have different deadlines.",
   "applies_to": [
    "negotiation"
   ],
   "source": "B3"
  },
  {
   "id": "B4b",
   "text": "Do not ask about today again for each product. Start each product at attempt 1.",
   "applies_to": [
    "negotiation"
   ],
   "source": "B4"
  },
  {
   "id": "B6b",
   "text": "If the customer names one date for everything and it is after one product's deadline, record that product on its own deadline and say so in the read-back. The other products keep the date the customer named.",
   "applies_to": [
    "negotiation",
    "confirmation"
   ],
   "source": "B6"
  },
  {
   "id": "B10b",
   "text": "A restructuring request still transfers the call. Promises recorded before the request stay. On any transfer add no notes at all, before or after it.",
   "applies_to": [
    "negotiation",
    "confirmation"
   ],
   "source": "B10"
  },
  {
   "id": "B11b",
   "text": "If one promise fails twice, keep the promises that were recorded and note the failed product as service_error.",
   "applies_to": [
    "confirmation"
   ],
   "source": "B11"
  },
  {
   "id": "Bc",
   "text": "With several products the promise outcome wins whenever at least one promise was recorded, except after a transfer.",
   "applies_to": [
    "all"
   ],
   "source": "B closing"
  }
 ],
 "rule_map": []
}
